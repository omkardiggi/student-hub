# ─────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in your OWN keys.
#  NEVER commit .env or share it. Rotate any key that leaks.
# ─────────────────────────────────────────────────────────────

# Groq — free at https://console.groq.com/keys  (used for lessons, photo-reading, audio)
GROQ_API_KEY=gsk_your_new_groq_key_here

# Which Groq models to use (change here if Groq renames them — see README)
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Presenton — for downloadable .pptx / .pdf decks (you can leave blank to skip)
# Hosted key from your Presenton account, OR a self-hosted Docker URL.
PRESENTON_API_KEY=sk-presenton_your_new_key_here
PRESENTON_BASE_URL=https://api.presenton.ai

# Session secret — set this to any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Port
PORT=3000

# ─── Fish Audio TTS (for English Study Debate Coordinator & English Interviewer) ───
FISH_AUDIO_API_KEY=0dd30c6eb32543e09c37578d33f4cf2b
FISH_AUDIO_VOICE_ID_ENGLISH=8bfd8af689fb4dea8f5c6c07f7d58c31

# ─── WhatsApp bot (optional — leave blank to run the web app only) ───
# From your Meta app → WhatsApp → API setup. See README section 7.
WA_TOKEN=your_whatsapp_access_token
WA_PHONE_ID=your_phone_number_id
# You choose this string; paste the SAME value into Meta's webhook "Verify token" box.
WA_VERIFY_TOKEN=studenthub-verify

# ─── Hackathon & Workshop finder ───
# Hackathons (Devpost) and the map (OpenStreetMap) work with NO key.
# Workshops are optional: get a free key at https://developer.ticketmaster.com to switch them on.
TICKETMASTER_API_KEY=your_ticketmaster_key_optional
